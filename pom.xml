<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>
    <groupId>com.user.managament</groupId>
    <artifactId>pilates-project</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>pilates-project</name>
    <description>Pilates Management Project - Parent</description>

    <properties>
        <java.version>17</java.version>
        <java-jwt.version>4.5.0</java-jwt.version>
    </properties>

    <modules>
        <module>pilates-app</module>
        <module>iam-module</module>
        <module>customer-module</module>
        <module>contract-module</module>
        <module>scheduling-module</module>
        <module>shared-module</module>
    </modules>

    <!--
    A seção de dependencyManagement para as dependências do Spring Boot foi removida.
    A herança do spring-boot-starter-parent já cuida disso para todos os módulos filhos.
    Apenas versões de dependências que não são gerenciadas pelo Spring (como java-jwt) são
    colocadas em <properties> para serem reutilizadas.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.auth0</groupId>
                <artifactId>java-jwt</artifactId>
                <version>${java-jwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>